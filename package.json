{
  "name": "asa-system",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @asa/ui dev",
    "build": "pnpm --filter @asa/contracts build && pnpm --filter @asa/ui build",
    "typecheck": "pnpm --filter @asa/ui typecheck",
    "lint": "pnpm --filter @asa/ui lint",
    "test:unit": "pnpm --filter @asa/ui test:unit",
    "test:e2e": "pnpm --filter e2e test",
    "format": "pnpm --filter @asa/ui format",
    "format:check": "pnpm --filter @asa/ui format:check"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
